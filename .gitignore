# 文件名：.gitignore
# 功能：Git 忽略文件配置
# 作者：CodeBuddy
# 创建时间：2025-09-19
# 版本：v1.0.0
# 备注：定义不需要版本控制的文件和目录

# Maven 构建输出
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle 构建输出
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IDE 文件
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.swp
*.swo

# Eclipse 文件
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans 文件
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志文件
*.log
logs/
log/

# 临时文件
*.tmp
*.temp
*.bak
*.swp
*~.nib

# 应用程序配置文件（包含敏感信息）
application-local.yml
application-dev.yml
application-prod.yml

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 上传文件目录
uploads/
files/

# Node.js（如果有前端项目）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 打包文件
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# 证书和密钥文件
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.crt
*.pem
*.key

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local