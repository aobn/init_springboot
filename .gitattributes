# 文件名：.gitattributes
# 功能：Git 属性配置文件，定义文件类型处理规则
# 作者：CodeBuddy
# 创建时间：2025-09-19
# 版本：v1.0.0
# 备注：适用于 Spring Boot 项目

# 自动检测文本文件并执行LF规范化
* text=auto

# 源代码文件 - 强制使用 LF 换行符
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf

# Web 前端文件
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf

# 配置文件
*.conf text eol=lf
*.config text eol=lf
*.ini text eol=lf
*.toml text eol=lf

# 文档文件
*.md text eol=lf
*.txt text eol=lf
*.adoc text eol=lf
*.rst text eol=lf

# Shell 脚本
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# 批处理脚本 - 保持 CRLF（Windows 需要）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件 - 不进行文本处理
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# 图片文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary

# 字体文件
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# 音视频文件
*.mp3 binary
*.mp4 binary
*.avi binary
*.mov binary
*.wav binary

# 证书和密钥文件
*.p12 binary
*.pfx binary
*.jks binary
*.keystore binary
*.truststore binary
*.crt binary
*.pem binary

# IDE 和构建工具生成的文件
*.class binary
*.so binary
*.dll binary
*.dylib binary

# Maven/Gradle 包装器脚本
mvnw text eol=lf
gradlew text eol=lf
mvnw.cmd text eol=crlf
gradlew.bat text eol=crlf

# Git 属性
.gitattributes text eol=lf
.gitignore text eol=lf

# Docker 文件
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# 语言特定的 diff 驱动
*.java diff=java
*.html diff=html
*.css diff=css

# 合并策略
*.properties merge=union
*.yml merge=union
*.yaml merge=union

# 导出忽略（不包含在 git archive 中）
.gitignore export-ignore
.gitattributes export-ignore
README.md export-ignore
docs/ export-ignore
scripts/ export-ignore
*.md export-ignore

# 语言统计忽略
*.min.js linguist-vendored
*.min.css linguist-vendored
target/ linguist-generated
build/ linguist-generated
node_modules/ linguist-vendored
vendor/ linguist-vendored